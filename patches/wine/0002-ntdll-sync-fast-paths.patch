+/* caller holds event_pool_mutex (uninterrupted section) */
+static void unlist_parked( HANDLE handle )
+{
+    unsigned int i, j;
+
+    for (i = 0; i < 2; i++)
+        for (j = 0; j < event_pool_count[i]; j++)
+            if (event_pool[i][j] == handle) event_pool[i][j] = event_pool[i][--event_pool_count[i]];
