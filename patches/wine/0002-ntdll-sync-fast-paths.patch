+/* the handle may be shared or referenced by the server from now on; a parked
+ * (closed) handle passed here by a buggy application is taken out of the pool
+ * and simply stays open */
+void inproc_sync_mark_escaped( HANDLE handle )
+{
+    struct inproc_sync *cache;
+    sigset_t pool_sigset;
+
+    if (inproc_device_fd < 0 || do_fsync() || !handle || is_pseudo_handle( handle )) return;
+    if ((cache = get_cached_inproc_sync( handle )))
+    {
+        if (cache->pool == EVENT_POOL_PARKED)
+        {
+            server_enter_uninterrupted_section( &event_pool_mutex, &pool_sigset );
+            unlist_parked( handle );
+            server_leave_uninterrupted_section( &event_pool_mutex, &pool_sigset );
+        }
+        cache->pool = EVENT_POOL_NONE;
+        release_inproc_sync( cache );
+    }
+}
+
+/* the application closed this handle already */
+BOOL inproc_sync_is_parked( HANDLE handle )
+{
+    struct inproc_sync *cache;
+    BOOL ret = FALSE;
+
+    if (inproc_device_fd < 0 || do_fsync() || !handle || is_pseudo_handle( handle )) return FALSE;
+    if ((cache = get_cached_inproc_sync( handle )))
+    {
+        ret = cache->pool == EVENT_POOL_PARKED;
+        release_inproc_sync( cache );
+    }
+    return ret;
+}
