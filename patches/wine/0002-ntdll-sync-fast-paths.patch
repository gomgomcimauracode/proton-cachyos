+/* called by NtClose(); returns TRUE if the handle was parked in the pool */
+BOOL inproc_sync_park_event( HANDLE handle, NTSTATUS *status )
+{
+    struct inproc_sync *cache;
+    sigset_t pool_sigset;
+    BOOL ret = FALSE;
+    int manual;
+
+    if (inproc_device_fd < 0 || do_fsync()) return FALSE;
+    if (!(cache = get_cached_inproc_sync( handle ))) return FALSE;
+
+    if (cache->pool == EVENT_POOL_PARKED)
+    {
+        /* closing a closed handle */
+        *status = STATUS_INVALID_HANDLE;
+        ret = TRUE;
+    }
+    /* one reference for the handle, one for us: nobody is using it right now */
+    else if ((cache->pool == EVENT_POOL_AUTO || cache->pool == EVENT_POOL_MANUAL) &&
+             ReadNoFence( &cache->refcount ) == 2)
+    {
+        manual = cache->pool == EVENT_POOL_MANUAL;
+        server_enter_uninterrupted_section( &event_pool_mutex, &pool_sigset );
+        if (event_pool_count[manual] < EVENT_POOL_MAX)
+        {
+            cache->pool = EVENT_POOL_PARKED;
+            event_pool[manual][event_pool_count[manual]++] = handle;
+            *status = STATUS_SUCCESS;
+            ret = TRUE;
+        }
+        server_leave_uninterrupted_section( &event_pool_mutex, &pool_sigset );
+    }
+    else if (cache->pool == EVENT_POOL_SEM && ReadNoFence( &cache->refcount ) == 2)
+    {
+        SEMAPHORE_BASIC_INFORMATION info;
+
+        /* only park semaphores with count 0, there is no ioctl to lower it */
+        if (!linux_query_semaphore_obj( cache->fd, &info ) && !info.CurrentCount)
+        {
+            server_enter_uninterrupted_section( &event_pool_mutex, &pool_sigset );
