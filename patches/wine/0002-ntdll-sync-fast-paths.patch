+    server_enter_uninterrupted_section( &event_pool_mutex, &pool_sigset );
+    for (i = sem_pool_count; i--;)
+    {
+        if (sem_pool[i].max != max) continue;
+        handle = sem_pool[i].handle;
+        sem_pool[i] = sem_pool[--sem_pool_count];
+        break;
+    }
+    server_leave_uninterrupted_section( &event_pool_mutex, &pool_sigset );
+    if (!handle) return 0;
+
+    if (!(cache = get_cached_inproc_sync( handle ))) return 0;
+    if (cache->pool == EVENT_POOL_PARKED &&
+        !(initial ? linux_release_semaphore_obj( cache->fd, initial, NULL ) : STATUS_SUCCESS))
+    {
+        cache->pool = EVENT_POOL_SEM;
+        release_inproc_sync( cache );
+        return handle;
+    }
+    release_inproc_sync( cache );
+    return 0;
+}
