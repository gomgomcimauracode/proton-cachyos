+            }
+            server_leave_uninterrupted_section( &event_pool_mutex, &pool_sigset );
+        }
+    }
+    release_inproc_sync( cache );
+    return ret;
+}
+
+static BOOL sync_attr_poolable( ACCESS_MASK access, ACCESS_MASK all_access, const OBJECT_ATTRIBUTES *attr )
+{
+    if (inproc_device_fd < 0 || do_fsync()) return FALSE;
+    if (access != all_access) return FALSE;
+    if (!attr) return TRUE;
+    return !attr->ObjectName && !attr->RootDirectory && !attr->SecurityDescriptor &&
+           !(attr->Attributes & OBJ_INHERIT);
+}
+
+static HANDLE unpark_event( BOOL manual, BOOLEAN state )
+{
+    struct inproc_sync *cache;
+    sigset_t pool_sigset;
+    HANDLE handle = 0;
+
+    server_enter_uninterrupted_section( &event_pool_mutex, &pool_sigset );
+    if (event_pool_count[manual]) handle = event_pool[manual][--event_pool_count[manual]];
+    server_leave_uninterrupted_section( &event_pool_mutex, &pool_sigset );
+    if (!handle) return 0;
+
+    if (!(cache = get_cached_inproc_sync( handle ))) return 0;
+    if (cache->pool == EVENT_POOL_PARKED &&
+        !(state ? linux_set_event_obj( cache->fd, NULL ) : linux_reset_event_obj( cache->fd, NULL )))
+    {
+        cache->pool = manual ? EVENT_POOL_MANUAL : EVENT_POOL_AUTO;
+        release_inproc_sync( cache );
+        return handle;
+    }
+    release_inproc_sync( cache );
+    return 0;
+}
+
+static HANDLE unpark_semaphore( LONG initial, LONG max )
+{
+    struct inproc_sync *cache;
+    sigset_t pool_sigset;
+    HANDLE handle = 0;
+    unsigned int i;
